# RoomTrail Frontend Environment Configuration Template
# Set the base URL for the Spring Boot backend API

# Local Development Default
VITE_API_URL=http://localhost:8080/api

# Production Deployment (when served behind a reverse proxy like Nginx or Caddy)
# VITE_API_URL=/api

# Production Deployment (when frontend and backend are hosted on separate domains)
# VITE_API_URL=https://api.yourdomain.com/api
