# ==============================================================================
# RoomTrail Backend Environment Configuration Template (Render Deployment)
# DO NOT COMMIT REAL PASSWORDS, TOKENS, OR SECRETS TO SOURCE CONTROL
# ==============================================================================

# Server Port (Injected dynamically by Render in cloud runtime; defaults to 8080 locally)
PORT=8080

# Active Spring Profile (Set to 'prod' for production deployment on Render)
SPRING_PROFILES_ACTIVE=prod

# Production MySQL Database Connection String
# Example connection formats for supported persistent MySQL providers:
# - Aiven MySQL:      jdbc:mysql://mysql-xyz.aivencloud.com:12345/roomtrail?useSSL=true&serverTimezone=UTC&characterEncoding=UTF-8
# - Railway MySQL:    jdbc:mysql://mysql.railway.internal:3306/railway?useSSL=true&serverTimezone=UTC&characterEncoding=UTF-8
# - Clever Cloud:     jdbc:mysql://bxyz-mysql.services.clever-cloud.com:3306/bxyz?useSSL=true&serverTimezone=UTC&characterEncoding=UTF-8
# - Render Persistent:jdbc:mysql://YOUR_MYSQL_HOST:3306/roomtrail?useSSL=true&serverTimezone=UTC&characterEncoding=UTF-8
SPRING_DATASOURCE_URL=jdbc:mysql://YOUR_PRODUCTION_DB_HOST:3306/roomtrail?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=YOUR_PRODUCTION_DB_USERNAME
SPRING_DATASOURCE_PASSWORD=YOUR_STRONG_PRODUCTION_DB_PASSWORD

# JPA Hibernate Schema Strategy ('update' safely adds missing tables without dropping existing data)
HIBERNATE_DDL_AUTO=update

# JWT Cryptographic Signing Secret Key (HMAC-SHA256: Must be at least 32 characters / 256 bits)
# Generate a cryptographically secure key:
#   Linux/macOS/Git Bash: openssl rand -base64 48
#   PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
JWT_SECRET=YOUR_MIN_32_CHAR_CRYPTOGRAPHIC_RANDOM_SECRET_KEY_HERE_256BIT
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated exact origins of your deployed Vercel frontend)
# IMPORTANT: DO NOT use wildcard '*' or localhost in production.
CORS_ALLOWED_ORIGINS=https://YOUR-APP-NAME.vercel.app
